<div class="col-lg-12 " id="place-description-block">
    

    {% if data['acdh:hasDescription'] %}
        <div class="hasdescription-container" >
            <div class="descriptionTextShort">
            {% for description in data.getData('acdh:hasDescription') %}
                <p class="description-text">{{ description.value|displayMarkdown }}</p>
            {% endfor %}
            </div>
            <div class="descriptionTextLong" style="display: none;">
                {% for description in data.getData('acdh:hasDescription') %}
                <p class="description-text">{{ description.value|displayMarkdown }}</p>
            {% endfor %}
                <a class="hasdescription-toggle-button" id="descriptionTextLongBtn">{{ "Show Less"|t }}</a>
            </div>

        </div>
    {% endif %}
    <ul>
         {% if data['acdh:hasPart'] %}
            <li>{{ include(arche_core_gui_path ~ '/templates/helper/helper-displayFields.html.twig', 
                    {'data': data['acdh:hasPart'], 'label':  'Part(s)' } ) }}</li>
        {% endif %}
         
         {% if data['acdh:isPartOf'] %}
            <li>{{ include(arche_core_gui_path ~ '/templates/helper/helper-displayFields.html.twig', 
                    {'data': data['acdh:isPartOf'], 'label':  'Is part of' } ) }}</li>
        {% endif %}
    </ul>
    
</div>
