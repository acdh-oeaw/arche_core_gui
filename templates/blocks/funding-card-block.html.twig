<div class="card metadata">
    <div class="card-header">
         <div class="row justify-content-center align-items-center">
            <div class="col-10"><h4 class="mb-0 pb-0">{{ "Funding"|trans }}</h4></div>
            <!-- <div class="col-2"><img src="{{arche_tooltip_ico}}" class="tooltip-icon-cards"></div>-->
            <div class="col-2 text-end">
                <button type="button" class="btn btn-link mdr-card-collapse-btn" data-bs-toggle="collapse" data-bs-target="#fundingBody" aria-expanded="true" aria-controls="fundingBody" aria-label="{{ "Toggle funding section"|trans }}">
            <i class="fa fa-solid fa-chevron-up"></i>
        </button>
            </div>
        </div>

    </div>
    <div id="fundingBody" class="collapse show">
        <div class="card-body meta-sidebar flex-column">
            {% for key, value in data %}
                <div>
                    <b>{{ key|trans }}:</b></br>
                    {% for val in value %}
                        {% if val['externalUrl'] %}
                            <a href="{{ val['externalUrl'] }}" target="_blank">{{ values }}</a><br>
                        {% elseif val['id'] %} 
                            <a href="/browser/metadata/{{ val['id'] }}" class="arche-href">{{ val['value'] }}</a><br>
                        {% else %}    
                            {{ val['value'] }}<br>
                        {% endif %}
                    {% endfor %}    
                </div>
            {% endfor %}
            
            {% if logos %}
                {% for key,value in logos %}
                    <img src="{{ value['value'] }}" class="" style="max-height: 72px; width: 100%" alt="{{ key|default('Funding logo')|trans }}" /><br>
                {% endfor %}  
            {% endif %}
        </div>
    </div>
</div>
