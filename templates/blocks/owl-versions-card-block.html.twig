<div class="card metadata">
    <div class="card-header">
         <div class="row justify-content-center align-items-center">
            <div class="col-10"><h4 class="mb-0 pb-0">{{ "Versions"|trans }}</h4></div>
            <!-- <div class="col-2"><img src="{{arche_tooltip_ico}}" class="tooltip-icon-cards"></div> -->
            <div class="col-2 text-end">
                <button type="button" class="btn btn-link mdr-card-collapse-btn" data-bs-toggle="collapse" data-bs-target="#versionsBody" aria-expanded="true" aria-controls="versionsBody" aria-label="{{ "Toggle versions section"|trans }}">
            <i class="fa fa-solid fa-chevron-up"></i>
        </button>
            </div>
        </div>
    </div>
    <div id="versionsBody" class="collapse show">
        <div class="card-body meta-sidebar versions-body">
           {% for key, value in data %}
               {{ value['value'] }}<br>
            {% endfor %}
            
        </div>
    </div>
</div>
